<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kết quả nhập file</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-4" style="max-width: 720px;">
    <h3 class="mb-3">Kết quả nhập file</h3>

    <% if (fatal) { %>
      <div class="alert alert-danger">Không đọc được file: <%= fatal %></div>
    <% } else { %>
      <div class="alert alert-success">Đã thêm <strong><%= ok %></strong> sản phẩm.</div>
      <% if (errors.length) { %>
        <div class="alert alert-warning">
          <strong><%= errors.length %> dòng bị bỏ qua:</strong>
          <ul class="mb-0 mt-2">
            <% errors.forEach(e => { %>
              <li>Dòng <%= e.line %>: <%= e.message %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    <% } %>

    <a href="/products" class="btn btn-primary">Về danh sách</a>
  </div>
</body>
</html>