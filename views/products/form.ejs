<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Thêm sản phẩm</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
  <div class="container py-4" style="max-width: 720px;">
    <h3 class="mb-3">
      <%= product.ProductID ? 'Cập nhật sản phẩm' : 'Thêm sản phẩm mới' %>
    </h3>

    <% if (error) { %>
      <div class="alert alert-danger">
        <%= error %>
      </div>
      <% } %>

        <form method="POST" action="<%= product.ProductID ? '/products/' + product.ProductID : '/products' %>"
          enctype="multipart/form-data" class="bg-white p-4 shadow-sm rounded">
          <div class="mb-3">
            <label class="form-label">Tên sản phẩm *</label>
            <input type="text" name="ProductName" class="form-control" value="<%= product.ProductName || '' %>"
              required>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Loại *</label>
              <input type="text" name="ProductType" class="form-control" list="types"
                value="<%= product.ProductType || '' %>" required>
              <datalist id="types">
                <option value="Vi điều khiển">
                <option value="Cảm biến">
                <option value="Điện trở">
                <option value="Tụ điện">
                <option value="IC">
                <option value="LED">
                <option value="Module">
                <option value="Phụ kiện">
              </datalist>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Đơn vị tính *</label>
              <input type="text" name="Unit" class="form-control" value="<%= product.Unit || 'cái' %>" required>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Số lượng *</label>
              <input type="number" name="Quantity" min="0" step="1" class="form-control"
                value="<%= product.Quantity ?? 0 %>" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Giá (đ) *</label>
              <input type="number" name="Price" min="0" step="1" class="form-control" value="<%= product.Price ?? 0 %>"
                required>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Mô tả / thông số</label>
            <textarea name="Description" rows="3" class="form-control"><%= product.Description || '' %></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label">Ảnh sản phẩm</label>
            <% if (product.PathImage) { %>
              <div class="mb-2">
                <img src="<%= product.PathImage %>" style="max-height:100px" class="rounded">
                <div class="form-text">Ảnh hiện tại. Chọn ảnh mới nếu muốn thay, không thì để trống.</div>
              </div>
              <% } %>
                <input type="file" name="image" accept="image/*" class="form-control" id="imageInput">
                <img id="preview" class="mt-2 rounded" style="display:none; max-height:140px;">
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" data-key="S" title="Alt+S">Lưu</button>
            <a href="/products" class="btn btn-outline-secondary" data-key="B" title="Alt+B">Hủy</a>
          </div>
        </form>
  </div>

  <script>
    document.getElementById('imageInput').addEventListener('change', (e) => {
      const file = e.target.files[0];
      const img = document.getElementById('preview');
      if (file) { img.src = URL.createObjectURL(file); img.style.display = 'block'; }
      else img.style.display = 'none';
    });
  </script>

  <script src="/js/shortcuts.js"></script>
</body>

</html>