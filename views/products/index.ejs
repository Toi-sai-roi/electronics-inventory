<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kho linh kiện điện tử</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Kho linh kiện điện tử</h3>
            <a href="/products/new" class="btn btn-primary text-nowrap" data-key="N" title="Alt+N">+ Thêm mới</a>
        </div>

        <form method="GET" action="/products" class="d-flex gap-2 mb-3">
            <input type="search" name="q" class="form-control" placeholder="tên, loại, giá, ngày, mô tả..."
                value="<%= q %>" data-key="T" title="Alt+T">
            <button type="submit" class="btn btn-primary text-nowrap" data-key="R" title="Alt+R">Tìm</button>
            <% if (q) { %><a href="/products" class="btn btn-outline-secondary text-nowrap" data-key="X" title="Alt+X">Xóa lọc</a>
                <% } %>
        </form>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">
                <%= q ? 'Tìm thấy' : 'Tổng cộng' %>
                    <%= total %> sản phẩm
            </p>
            <div class="d-flex gap-2">
                <button type="button" id="selectAllBtn" class="btn btn-outline-secondary btn-sm text-nowrap" data-key="A" title="Alt+A">Chọn tất
                    cả</button>
                <button type="submit" form="deleteForm" formaction="/products/copy" id="copyBtn"
                    class="btn btn-outline-primary btn-sm text-nowrap" disabled data-key="C" title="Alt+C">Sao chép đã chọn</button>
                <button type="submit" form="deleteForm" id="deleteBtn" class="btn btn-danger btn-sm text-nowrap"
                    disabled data-key="D" title="Alt+D">Xóa đã chọn</button>
                <button type="submit" form="deleteForm" formaction="/products/export" name="format" value="xlsx"
                    class="btn btn-outline-success btn-sm text-nowrap" data-key="E" title="Alt+E">Xuất Excel</button>
                <button type="submit" form="deleteForm" formaction="/products/export" name="format" value="json"
                    class="btn btn-outline-success btn-sm text-nowrap" data-key="J" title="Alt+J">Xuất JSON</button>
                <button type="button" id="importBtn" class="btn btn-outline-dark btn-sm text-nowrap" data-key="I" title="Alt+I">Nhập file</button>
                <details class="position-relative">
                    <summary class="btn btn-outline-secondary btn-sm text-nowrap">Cột hiển thị</summary>
                    <div id="colMenu" class="position-absolute end-0 bg-white border rounded shadow-sm p-2"
                        style="z-index:10; min-width:160px"></div>
                </details>
            </div>
        </div>

        <div class="table-responsive bg-white shadow-sm rounded">
            <form id="importForm" method="POST" action="/products/import" enctype="multipart/form-data" class="d-none">
                <input type="file" name="file" id="importFile" accept=".xlsx,.json">
            </form>
            <form id="deleteForm" method="POST" action="/products/delete">
                <input type="hidden" name="q" value="<%= q %>">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>STT</th>
                            <th>Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Loại</th>
                            <th class="text-end">SL</th>
                            <th>ĐVT</th>
                            <th class="text-end">Giá (đ)</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach((p, i)=> { %>
                            <% if (!products.length) { %>
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-4">Không tìm thấy sản phẩm nào</td>
                                </tr>
                                <% } %>
                                    <tr class="product-row" style="cursor:pointer; user-select:none">
                                        <td><input type="checkbox" name="ids" value="<%= p.ProductID %>"
                                                class="row-check d-none">
                                            <%= (page - 1) * limit + i + 1 %>
                                        </td>
                                        <td>
                                            <% if (p.PathImage) { %>
                                                <img src="<%= p.PathImage %>" width="48" height="48"
                                                    style="object-fit:cover" class="rounded">
                                                <% } else { %>
                                                    <span class="text-muted small">—</span>
                                                    <% } %>
                                        </td>
                                        <td>
                                            <%= p.ProductName %>
                                        </td>
                                        <td><span class="badge text-bg-secondary">
                                                <%= p.ProductType %>
                                            </span></td>
                                        <td class="text-end">
                                            <%= p.Quantity %>
                                        </td>
                                        <td>
                                            <%= p.Unit %>
                                        </td>
                                        <td class="text-end">
                                            <%= Number(p.Price).toLocaleString('vi-VN') %>
                                        </td>
                                        <td>
                                            <%= new Date(p.CreateDate).toLocaleDateString('vi-VN') %>
                                        </td>
                                        <td>
                                            <a href="/products/<%= p.ProductID %>"
                                                class="btn btn-sm btn-outline-info">Xem</a>
                                            <a href="/products/<%= p.ProductID %>/edit"
                                                class="btn btn-sm btn-outline-primary">Sửa</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                    </tbody>
                </table>
        </div>
        </form>

        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= base %>page=<%= page - 1 %>">Trước</a>
                </li>
                <% for (let i=1; i <=totalPages; i++) { %>
                    <li class="page-item <%= i === page ? 'active' : '' %>">
                        <a class="page-link" href="<%= base %>page=<%= i %>">
                            <%= i %>
                        </a>
                    </li>
                    <% } %>
                        <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="<%= base %>page=<%= page + 1 %>">Sau</a>
                        </li>
            </ul>
        </nav>
    </div>
    <script src="/js/shortcuts.js"></script>

    <script>
        const selectAllBtn = document.getElementById('selectAllBtn');
        const deleteBtn = document.getElementById('deleteBtn');
        const rowChecks = document.querySelectorAll('.row-check');
        const copyBtn = document.getElementById('copyBtn');

        function refresh() {
            let n = 0;
            rowChecks.forEach((c) => {
                c.closest('tr').classList.toggle('table-primary', c.checked);
                if (c.checked) n++;
            });
            deleteBtn.disabled = n === 0;
            copyBtn.disabled = n === 0;
            copyBtn.textContent = n ? 'Sao chép đã chọn (' + n + ')' : 'Sao chép đã chọn';
            deleteBtn.textContent = n ? 'Xóa (' + n + ')' : 'Xóa';
            selectAllBtn.textContent = n === rowChecks.length ? 'Bỏ chọn tất cả' : 'Chọn tất cả';
        }

        // Bấm vào dòng = chọn / bỏ chọn
        document.querySelectorAll('.product-row').forEach((row) => {
            row.addEventListener('click', (e) => {
                if (e.target.closest('a, button')) return; // bấm Xem/Sửa thì chỉ chuyển trang
                const cb = row.querySelector('.row-check');
                cb.checked = !cb.checked;
                refresh();
            });
        });

        // Nút Chọn tất cả: đang chọn hết thì bỏ hết, ngược lại thì chọn hết
        selectAllBtn.addEventListener('click', () => {
            const allChecked = [...rowChecks].every((c) => c.checked);
            rowChecks.forEach((c) => (c.checked = !allChecked));
            refresh();
        });

        document.getElementById('deleteForm').addEventListener('submit', (e) => {
            if (e.submitter && e.submitter.id !== 'deleteBtn') return; // Sao chép thì khỏi hỏi
            const n = document.querySelectorAll('.row-check:checked').length;
            if (!confirm('Xóa ' + n + ' sản phẩm đã chọn?')) e.preventDefault();
        });

        // Bấm "Nhập file" -> mở hộp chọn file -> chọn xong tự gửi
        const importFile = document.getElementById('importFile');
        document.getElementById('importBtn').addEventListener('click', () => importFile.click());
        importFile.addEventListener('change', () => {
            if (importFile.files.length) document.getElementById('importForm').submit();
        });

        // ---- Ẩn/hiện cột ----
        const table = document.querySelector('table');
        const heads = [...table.querySelectorAll('thead th')].map((th) => th.textContent.trim());
        const KEY = 'hiddenCols';

        let hidden = []; // mảng vị trí các cột đang ẩn
        try { hidden = JSON.parse(localStorage.getItem(KEY)) || []; } catch (e) { }

        const styleTag = document.createElement('style');
        document.head.appendChild(styleTag);

        function applyHidden() {
            // Mỗi cột ẩn = 1 luật CSS: ẩn ô thứ (i+1) của mọi dòng
            styleTag.textContent = hidden
                .map((i) => `table tr > *:nth-child(${i + 1}) { display: none; }`)
                .join('\n');
            try { localStorage.setItem(KEY, JSON.stringify(hidden)); } catch (e) { }
        }

        const menu = document.getElementById('colMenu');
        heads.forEach((name, i) => {
            const label = document.createElement('label');
            label.className = 'd-flex align-items-center gap-2 py-1';

            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.className = 'form-check-input m-0';
            cb.checked = !hidden.includes(i);

            cb.addEventListener('change', () => {
                if (cb.checked) hidden = hidden.filter((j) => j !== i);
                else hidden.push(i);
                applyHidden();
            });

            label.append(cb, name);
            menu.appendChild(label);
        });

        applyHidden();
    </script>
</body>

</html>